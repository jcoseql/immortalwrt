# 目标硬件三围：树莓派 5 专属 BCM2712
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2712=y
CONFIG_TARGET_bcm27xx_bcm2712_DEVICE_raspberrypi_5=y

# 核心网络驱动（焊死你的 Radxa Dual 2.5G 扩展板驱动）
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 核心依赖（扩容和底层必备工具）
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_e2fsprogs=y

# 核心应用：内置满血版 daed 极其组件
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y

# 常用基础套件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_tailscaled=y
