# ============================================================
# ImmortalWrt 25.12.0 Raspberry Pi 5 + Radxa Dual 2.5G HAT
# extra_packages 模式：只写与官方默认 bcm2712 config 的差异
# ============================================================

# 目标硬件
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2712=y
CONFIG_TARGET_bcm27xx_bcm2712_DEVICE_raspberrypi_5=y

# squashfs-only（砍 ext4，省出 30MB 编译空间 + ROM 体积）
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# ===== 移除官方默认包（有线路由，砍WiFi/声音/HID） =====
# CONFIG_PACKAGE_kmod-brcmfmac is not set
# CONFIG_PACKAGE_cypress-firmware-43455-sdio is not set
# CONFIG_PACKAGE_brcmfmac-nvram-43455-sdio is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_kmod-sound-core is not set
# CONFIG_PACKAGE_kmod-sound-arm-bcm2835 is not set
# CONFIG_PACKAGE_kmod-usb-hid is not set
# CONFIG_PACKAGE_kmod-r8169 is not set

# ===== 额外包（extra_packages） =====
#
# --- 网卡驱动 ---
CONFIG_PACKAGE_kmod-r8125=y

# --- Docker 不编译——进系统后 apk add dockerd docker-compose ---
# CONFIG_PACKAGE_dockerd=y  # flash then: apk add
# CONFIG_PACKAGE_docker-compose is not set  # 编译炸，用二进制注入方案
# CONFIG_PACKAGE_cgroupfs-mount=y  # flash then: apk add
# CONFIG_PACKAGE_kmod-br-netfilter=y  # flash then: apk add
# CONFIG_PACKAGE_luci-app-dockerman=y  # flash then: apk add
# CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y  # flash then: apk add

# --- Docker 依赖：iptables-nft (438B) ---
# CONFIG_PACKAGE_iptables-nft=y  # flash then: apk add

# --- eBPF + TProxy（Docker daed 内核侧支持） ---
CONFIG_PACKAGE_kmod-bpf=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_tc-bpf=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y

# --- Tailscale（原生 nftables 模式，不需要 iptables） ---
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_tailscaled=y

# --- TCP 优化 ---
CONFIG_PACKAGE_kmod-tcp-bbr=y

# --- 磁盘工具（扩容/分区） ---
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# --- LuCI 中文 ---
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- Web 终端 ---
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# --- UPnP ---
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# --- 排查工具 ---
CONFIG_PACKAGE_iperf3=y

# --- SFTP（Tabby 文件传输） ---
CONFIG_PACKAGE_openssh-sftp-server=y
