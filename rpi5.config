# 目标硬件：树莓派 5 + Radxa Dual 2.5G HAT (RTL8125 x2)
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2712=y
CONFIG_TARGET_bcm27xx_bcm2712_DEVICE_raspberrypi_5=y

# 根分区 2GB，squashfs 保留后悔药
CONFIG_TARGET_ROOTFS_SIZE=2048
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# ===== 网卡驱动 =====
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y

# ===== eBPF + TProxy（Docker daed 需要宿主机内核支持） =====
CONFIG_PACKAGE_kmod-bpf=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_tc-bpf=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y

# ===== Docker 全家桶 =====
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y

# ===== Tailscale =====
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_tailscaled=y

# ===== TCP 优化 =====
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ===== 磁盘工具（扩容/分区） =====
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# ===== 基础套件 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ===== UPnP =====
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ===== CPU 调频 =====
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# ===== 排查工具 =====
CONFIG_PACKAGE_iperf3=y

# ===== 移除无用包（省空间，纯有线路由） =====
# 不编译 daed 进固件 — Docker 跑
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# 砍 WiFi/BT/声音
# CONFIG_PACKAGE_kmod-brcmfmac is not set
# CONFIG_PACKAGE_brcmfmac-firmware-43455-sdio is not set
# CONFIG_PACKAGE_kmod-sound-core is not set
# CONFIG_PACKAGE_kmod-snd-soc-core is not set
# 砍不用的有线网卡驱动
# CONFIG_PACKAGE_kmod-r8169 is not set
