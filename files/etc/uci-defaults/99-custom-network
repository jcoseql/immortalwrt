#!/bin/sh
# uci-defaults: 首次启动自动配置网络
# 用 uci-defaults 替代硬编码 /etc/config/network 的原因：
#   - 硬编码 → 烧进 squashfs，firstboot 清不掉 → 重置后炸网
#   - uci-defaults → 每次 firstboot 后重新执行 → 永远不会炸网
#
# eth0 = RP1 板载百兆 | eth1 = R8125 #1 (2.5G LAN)
# eth2 = R8125 #2 (1G WAN)
# br-lan = eth0 + eth1 桥接

uci -q batch <<-EOF
    set network.loopback=interface
    set network.loopback.device='lo'
    set network.loopback.proto='static'
    set network.loopback.ipaddr='127.0.0.1'
    set network.loopback.netmask='255.0.0.0'

    set network.globals=globals
    set network.globals.ula_prefix='fd00::/8'

    set network.br_lan=device
    set network.br_lan.name='br-lan'
    set network.br_lan.type='bridge'
    set network.br_lan.ports='eth0 eth1'

    set network.lan=interface
    set network.lan.device='br-lan'
    set network.lan.proto='static'
    set network.lan.ipaddr='192.168.1.1'
    set network.lan.netmask='255.255.255.0'
    set network.lan.ip6assign='60'

    set network.wan=interface
    set network.wan.device='eth2'
    set network.wan.proto='dhcp'

    set network.wan6=interface
    set network.wan6.device='eth2'
    set network.wan6.proto='dhcpv6'
EOF

uci commit network

exit 0
